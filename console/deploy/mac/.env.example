# The GET.route console on the Mac mini. Copy to .env in this folder
# (README.md makes it for you). Never send these through chat, email or git.

# The owner's way in to this console (at least 24 characters): openssl rand -hex 32
WZ_ADMIN_TOKEN=
# Encrypts the Waze servers' keys and signs console sign-ins: openssl rand -base64 32
WZ_SECRET_KEY=

WZ_PUBLIC_URL=https://waze.getcdn.link

# The port on this Mac that the Cloudflare Tunnel sends waze.getcdn.link to.
WZ_PORT=8200
