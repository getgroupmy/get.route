# GET.route console (waze.getcdn.link). Copy to .env next to docker-compose.yml.
# Type the secrets on the NAS; never send them through chat, email or git.

# The owner's way in to the console (at least 24 characters): openssl rand -hex 32
WZ_ADMIN_TOKEN=
# Encrypts the Waze servers' keys and signs console sign-ins: openssl rand -base64 32
WZ_SECRET_KEY=

WZ_PUBLIC_URL=https://waze.getcdn.link

# Where the database lives on the NAS (made in step 1 of README.md).
WZ_DATA_PATH=/volume1/docker/get-route-console/data

# GET.route's Docker network on the NAS, so the console reaches get-route-pool
# by name. Its NAME, from:
#   sudo docker inspect get-route-tunnel --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=
