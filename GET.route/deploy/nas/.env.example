# Copy to .env and fill in. Never commit .env.

# The secret GET.ride sends in X-Route-Key. Make one with:
#   openssl rand -hex 32
# Paste the same value into Admin > Settings > Fare AI > Waze servers > Key.
ROUTE_API_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker:
# the token after --token. Add one public hostname per state container, e.g.
# route-johor.getride.my -> http://get-route-johor:8000 (full list at the top
# of docker-compose.yml).
TUNNEL_TOKEN=

# Memory cap per state container (16 of them). Raise it if Container Manager
# shows containers being stopped for running out of memory.
MEM_PER_SERVER=1g
