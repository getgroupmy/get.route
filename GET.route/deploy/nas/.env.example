# Copy to .env and fill in. Never commit .env.

# The secret GET.ride sends in X-Route-Key. Make one with:
#   openssl rand -hex 32
# Paste the same value into Admin > Settings > Fare AI > Waze servers > Key.
ROUTE_API_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker:
# the token after --token. Add ONE public hostname, for the dispatcher:
# route.getride.my -> http://get-route-pool:8000
TUNNEL_TOKEN=

# Memory cap per Waze container (16 of them; usually only 1-2 have Chrome open).
MEM_PER_SERVER=1g

# Pool rules (pool_server.py): queries per container per minute before the
# next one takes over, the query of the minute that warms the next one, and
# how long a failing container is skipped.
POOL_SWITCH_AT=23
POOL_WARM_AT=10
POOL_REST_SECONDS=60
# Containers (the first ones) kept warm between fares, and how often (s).
POOL_KEEP_WARM=1
POOL_KEEP_WARM_SECONDS=240
