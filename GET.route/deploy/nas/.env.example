# Copy to .env and fill in. Never commit .env.

# The secret GET.ride sends in X-Route-Key. Make one with:
#   openssl rand -hex 32
# Paste the same value into Admin > Settings > Fare AI > Waze servers > Key.
ROUTE_API_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker:
# the token after --token. Point a public hostname (e.g. route1.getride.my)
# at http://get-route:8000.
TUNNEL_TOKEN=
