# GET.route on a Mac mini (Apple chip): copy to .env next to start.sh.

# The secret GET.ride sends in X-Route-Key. Make a new one for the Mac
# (openssl rand -hex 32) and paste it on the Mac's Waze server card in Admin.
ROUTE_API_KEY=

# How many Waze processes (each opens one Chrome window when it has work).
# Each serves about 23 Waze calls a minute; 4 = about 90 a minute, with the
# NAS pool behind it as the fallback.
WORKERS=4

# The dispatcher's port (cloudflared sends route-mac.getride.my here) and
# the first worker's port (the others follow: 8101, 8102, ...).
POOL_PORT=8100
BASE_PORT=8101

# Who can reach the dispatcher: 127.0.0.1 (this Mac only) or
# 0.0.0.0 (also the office network: the GET.route console on the NAS asks it
# at http://MAC_IP:8100, with the key above). The workers always stay local.
POOL_HOST=0.0.0.0

# As on the NAS (see ../nas/.env.example).
POOL_SWITCH_AT=23
POOL_WARM_AT=10
POOL_REST_SECONDS=60
POOL_KEEP_WARM=1
POOL_KEEP_WARM_SECONDS=240
