<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts GET.route at login and again if it stops. Copy to
     ~/Library/LaunchAgents/ and replace /Users/YOU/get.route with where the
     repository is (README.md, step 5). A LaunchAgent, not a LaunchDaemon:
     Chrome needs the logged-in user's screen. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.getride.getroute</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOU/get.route/GET.route/deploy/mac/start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/get.route/GET.route/deploy/mac/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/get.route/GET.route/deploy/mac/logs/launchd.log</string>
</dict>
</plist>
